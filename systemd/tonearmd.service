[Unit]
Description=tonearm — Roon bridge for the Omarchy shell bar
After=graphical-session.target
# If the plugin directory was removed before the user unit, skip startup
# instead of repeatedly failing at EXEC (203) under Restart=on-failure.
ConditionPathExists=%h/.config/omarchy/plugins/ssandys.tonearm/scripts/tonearmd
# Retry forever. The daemon's only retry mechanism is exiting non-zero and
# letting Restart=on-failure below bring it back, so systemd's default start
# limit (5 starts / 10s) is the thing that would cap it -- and hitting that cap
# leaves the unit `failed` and silent, which is strictly worse than merely
# disconnected: the bar shows a stale track and nothing retries.
#
# Today the cap cannot be reached, but only by accident: sood.discover()'s
# receive loop runs for its full timeout (6s default) even when no interface
# has a usable address, so a fail-restart cycle is ~9s and at most 2 starts
# land in any rolling 10s window. Nothing designed that margin and no test
# guards it -- shortening that timeout, or swapping the vendored library,
# would silently reintroduce "the daemon never retries".
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.config/omarchy/plugins/ssandys.tonearm/scripts/tonearmd
Restart=on-failure
RestartSec=3
# The socket lives here; systemd creates and cleans it up. Under
# ProtectSystem=strict below this is also the ONLY writable path under
# $XDG_RUNTIME_DIR, so the name must stay in step with server.runtime_dir().
RuntimeDirectory=tonearm
RuntimeDirectoryMode=0700

# --- sandbox ------------------------------------------------------------
#
# tonearmd needs very little: a unix socket under $XDG_RUNTIME_DIR, its own
# ~/.config/tonearm, outbound TCP/UDP to the LAN, and the session bus for
# MPRIS. Everything below is the difference between "the daemon needs that"
# and "the daemon runs as you". Without it, a bug in this daemon -- or in
# the vendored roonapi it feeds untrusted LAN bytes to -- reaches every file
# the user owns.
#
# Every directive here was verified against a running daemon on 2026-09-02,
# not copied from a template. Two of them are load-bearing in ways that are
# not obvious:
#
#   * AF_NETLINK is REQUIRED. glibc's if_nameindex(3), which sood.py uses to
#     enumerate interfaces, talks netlink. Drop it and _local_networks()
#     returns nothing -- discovery finds no Core and reports no error, so a
#     first run just sits at "unpaired" forever.
#   * Required bind sources must EXIST at start or systemd fails at step
#     NAMESPACE (226). setup.sh creates the private state directory; it must
#     not create the optional session bus socket owned by the user manager.
#     tests/python/test_setup.py asserts these distinct requirements.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
# tmpfs, not read-only. `read-only` still exposes every file the user owns
# for READING -- ~/.ssh, browser profiles, password stores -- to a daemon that
# parses untrusted LAN bytes through a vendored library and has outbound
# network to send them somewhere. An empty tmpfs plus narrow binds is the
# difference between "cannot write your home" and "cannot see it".
ProtectHome=tmpfs
# Its own code, since ExecStart lives here and $HOME is now empty.
BindReadOnlyPaths=%h/.config/omarchy/plugins/ssandys.tonearm
# ProtectHome=tmpfs also hides /run/user. Expose only the session bus socket
# for MPRIS; absence must not prevent ordinary Roon/IPC operation. The user
# manager owns this socket, not setup.sh or RuntimeDirectory=tonearm.
BindReadOnlyPaths=-%t/bus
# Its own state: Core address, pairing token, pinned zone.
BindPaths=%h/.config/tonearm

# Measured on a running daemon, not chosen from a template -- the same rule
# as the directives above. Steady state is 6 threads, 12 descriptors and a
# 36 MB peak RSS. The spike is discovery's /24 sweep, whose ThreadPoolExecutor
# is 128 workers: measured at 130 threads and 132 descriptors at peak.
#
# So TasksMax must clear ~134, and a value like 64 would not break anything
# visible -- it would break the sweep, which is the fallback relocation needs
# on a LAN where multicast never arrives (#17). These leave roughly 2x.
TasksMax=256
LimitNOFILE=512
# Art is capped at 1 MiB on the wire and its decoded dimensions are checked,
# so steady use is tens of MB. This is not a tight bound, it is a ceiling: the
# point is that a runaway in the daemon is killed as the daemon rather than
# taken out of the desktop session by the OOM killer, after which
# Restart=on-failure brings it back.
MemoryMax=256M
# Tested live before shipping, because it breaks anything that JITs: every
# daemon import -- roonapi, websocket, dbus_next and tonearm_lib itself --
# loads and runs under it on plain CPython. Revisit if the interpreter's
# experimental JIT is ever enabled in this distribution's build.
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# The pairing token is written here; 0600 no matter what the process asks for.
UMask=0077

[Install]
WantedBy=default.target
